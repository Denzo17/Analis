# amoCRM private integration credentials (Настройки → Интеграции → ваша интеграция)
AMO_CLIENT_ID=
AMO_CLIENT_SECRET=
# Должен совпадать с "Ссылкой для перенаправления" в настройках интеграции
AMO_REDIRECT_URI=https://your-domain.example/oauth/callback

# Публичный базовый URL этого сервера (без слэша на конце)
APP_BASE_URL=https://your-domain.example

# Код виджета из widget/manifest.json (widget.code)
WIDGET_CODE=leads_analysis

# Секрет для подписи короткоживущих сессионных JWT, которые фронтенд дашборда
# использует для вызовов бэкенда после того, как iframe подтвердил, что он
# открыт легитимным amoCRM-аккаунтом. Сгенерируйте случайную строку.
SESSION_JWT_SECRET=change-me-to-a-random-64-char-string

PORT=3000
DB_PATH=./data/app.sqlite

# Пароль для входа на отдельную страницу дашборда https://ваш-домен/dashboard
# (используется вместо встраивания в интерфейс amoCRM — см. README "Доступ
# к дашборду"). Придумайте свой, не оставляйте пустым.
DASHBOARD_PASSWORD=change-me
